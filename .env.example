# Database connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/jobscheduler

# JWT Authentication secret, algorithm, and token expiry in minutes
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# Worker lease timeout before stale job recovery by reaper
WORKER_LEASE_DURATION_SECONDS=300
# Interval in seconds between worker heartbeat updates to database
HEARTBEAT_INTERVAL_SECONDS=10
# Interval in seconds for background reaper loop to reclaim stale jobs
REAPER_INTERVAL_SECONDS=60
# Interval in seconds for recurring cron scheduler loop to spawn jobs
RECURRING_SCHEDULER_INTERVAL_SECONDS=60
# Timeout in seconds granted for in-flight jobs to complete during graceful shutdown
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30
# Structured logging output format (text or json)
LOG_FORMAT=text

# API Server bind host and port
API_HOST=0.0.0.0
API_PORT=8000

# Optional API key for LLM-backed AI failure summary feature (Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
